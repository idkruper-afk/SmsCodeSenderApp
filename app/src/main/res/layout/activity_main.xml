<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header Bar with Title and Top-Right Settings Button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="SMS Code Keypad"
                android:textSize="22sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnTopRightSettings"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚙ Settings"
                android:textAllCaps="false" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvPermissionStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Checking SMS Permission..."
            android:textStyle="bold"
            android:textSize="14sp"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:id="@+id/layoutPermissionButtons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <Button
                android:id="@+id/btnGrantPermission"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Grant SMS Permission"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btnAppSettings"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="Open App Settings"
                android:textAllCaps="false" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tap any button below to send its SMS code, or long-press a button to customize its label and code."
            android:textSize="13sp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="Quick Code Buttons (Long-Press to Edit)"
            android:textStyle="bold" />

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:rowCount="3"
            android:alignmentMode="alignMargins"
            android:columnOrderPreserved="false">

            <Button
                android:id="@+id/btnCode1"
                android:layout_width="0dp"
                android:layout_height="84dp"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                android:text="Code 1"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btnCode2"
                android:layout_width="0dp"
                android:layout_height="84dp"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                android:text="Code 2"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btnCode3"
                android:layout_width="0dp"
                android:layout_height="84dp"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                android:text="Code 3"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btnCode4"
                android:layout_width="0dp"
                android:layout_height="84dp"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                android:text="Code 4"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btnCode5"
                android:layout_width="0dp"
                android:layout_height="84dp"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                android:text="Code 5"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btnCode6"
                android:layout_width="0dp"
                android:layout_height="84dp"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                android:text="Code 6"
                android:textAllCaps="false" />
        </GridLayout>

    </LinearLayout>
</ScrollView>
